# Sitenin herkese açık adresi (canonical, sitemap, RSS ve Open Graph için).
NEXT_PUBLIC_SITE_URL=https://personadijitalpazarlama.com

# Supabase projesi → Project Settings → API.
# Yalnızca anon (publishable) anahtar gerekir; service_role anahtarı KULLANILMAZ.
# Bütün yetkilendirme veritabanındaki RLS politikalarıyla yapılır.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "AI ile Blog Oluştur" özelliği için Gemini API anahtarı (https://aistudio.google.com/apikey).
# YALNIZCA sunucuda okunur; başına NEXT_PUBLIC_ ekleme ve bu dosyaya gerçek anahtar yazma.
# Canlıda Vercel → Settings → Environment Variables'a eklenir.
GEMINI_API_KEY=

# İsteğe bağlı: önce denenecek model(ler), virgülle ayrılır. Yalnızca ücretsiz katmandaki
# metin modelleri kabul edilir (lib/ai/gemini.js içindeki FREE_TEXT_MODELS); başka bir
# model yazılırsa özellik çalışmaz, ücretli modele kendiliğinden geçilmez.
# GEMINI_MODEL=gemini-3.8-flash

# --- AI Blog Stüdyosu: URL okuyucu zinciri (hepsi isteğe bağlı) -----------------
# Sıra: yerel okuyucu → Jina Reader → Firecrawl → tarayıcı. Yerel okuyucu yeterli
# metin bulursa diğerlerine hiç istek gitmez. URL her sağlayıcıdan önce özel ağ
# denetiminden geçer.
# Jina anahtarsız da çalışır (düşük hız sınırı); anahtar verilirse kullanılır.
# JINA_API_KEY=
# Firecrawl yalnızca anahtar varsa denenir; kredi bitince 6 saat atlanır.
# FIRECRAWL_API_KEY=
# Tarayıcı okuyucusu yalnızca yerelde: playwright-core + yerel Chromium gerekir.
# Vercel'de her durumda kapalıdır.
# PLAYWRIGHT_READER=1
# Chromium yolu (boşsa ~/Library/Caches/ms-playwright altındaki headless shell aranır).
# PLAYWRIGHT_CHROMIUM_PATH=

# --- Ücretsiz AI rotasyonu ve kullanım limitleri (docs/AI_PROVIDERS_AND_LIMITS.md) ---
# Kalıcı limit deposu. CANLIDA ZORUNLU: tanımlanmazsa canlıda ücret riski taşıyan
# servisler (Gemini, Groq, Cloudflare) güvenlik için çağrılmaz. Supabase'de
# 20261023000000_ai_usage_jobs.sql migration'ı uygulanmış olmalıdır.
# AI_USAGE_STORE=supabase
# Yerelde varsayılan "file" deposunun yolu (varsayılan .data/ai-usage.json).
# AI_USAGE_FILE=

# İsteğe bağlı ücretsiz metin sağlayıcıları (anahtar yoksa atlanır). Groq ve Cloudflare,
# panelde "Hesabın ücretsiz planda olduğunu doğruladım" işaretlenmeden kullanılmaz.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Cloudflare Workers AI (metin + FLUX görsel; günde 10.000 Neuron ortak).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Günlük Neuron bütçesi (en fazla 10000; varsayılan 9000).
# CLOUDFLARE_NEURON_BUDGET=

# Kendi ComfyUI sunucunuz (canlıda yalnızca https + token).
# COMFYUI_URL=
# COMFYUI_CHECKPOINT=
# COMFYUI_TOKEN=

# Design Arena sıralama API'si (yalnızca panelde bilgi; başvuru ile alınır).
# DESIGN_ARENA_API_KEY=
